{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/price-alerts",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/expire-bookings",
      "schedule": "*/10 * * * *"
    }
  ],
  "functions": {
    "app/api/cron/price-alerts/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/expire-bookings/route.ts": {
      "maxDuration": 120
    }
  }
}
