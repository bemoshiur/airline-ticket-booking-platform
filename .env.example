# ---------------------------------------------------------------------------
# Flight distribution (Phase 1.5)
# ---------------------------------------------------------------------------
# Primary shopping channel: "database" (local inventory) or "amadeus" (GDS).
# Amadeus falls back to "database" automatically if it is down or unconfigured.
FLIGHT_PROVIDER=

# Amadeus Self-Service — https://developers.amadeus.com
# Test:  https://test.api.amadeus.com    Production: https://api.amadeus.com
AMADEUS_BASE_URL=
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# Amadeus cannot quote BDT; fares are shopped here and converted to BDT.
AMADEUS_CURRENCY=

# FX rates as BDT per unit, overriding lib/fx.ts defaults.
# Example: FX_RATES_JSON={"USD":122.5,"EUR":133.0}
FX_RATES_JSON=
